{
  "name": "just-following",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "amo": "node --env-file-if-exists=.env scripts/amo.mjs",
    "sign": "node --env-file-if-exists=.env node_modules/web-ext/bin/web-ext.js sign"
  },
  "webExt": {
    "sourceDir": ".",
    "artifactsDir": "artifacts",
    "ignoreFiles": ["tests", "artifacts", "scripts", "store", "package*.json", "AGENTS.md", "README.md", ".gitignore", "docs", ".env", ".env.*", ".web-extension-id", ".amo-upload-uuid"]
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "web-ext": "^10.7.0"
  }
}
