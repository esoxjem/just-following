{
  "manifest_version": 3,
  "name": "Just Following",
  "version": "0.1.0",
  "description": "A quieter Instagram: posts, Stories, and Reels from people you follow, without recommended feeds or Explore.",
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "96": "icon.svg",
    "128": "icon.svg"
  },
  "content_scripts": [{
    "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_start"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "just-following@local.just-following",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
